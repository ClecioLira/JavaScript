<%- include('includes/head') %>
<%- include('includes/nav') %>

  <div class="container">
    <div class="row">
      <div class="col-lg-2"></div>

      <div class="col-lg-8 my-3">
        <h1 class="text-center">Criar contra ou Entrar</h1>
        <p class="text-center lead">Crie sua conta ou faça seu login abaixo.</p>

        <%- include('includes/messages') %>

        <div class="row">
            <div class="col-lg my-5">
                <h4>Faça o seu cadastro</h4>
                <form class="form-cadastro" action="/login/criar" method="POST">
                    <input type="hidden" name="_csrf" value=<%= csrfToken%>>
                    <div class="form-group">
                      <label>Seu email</label>
                      <input type="email" class="form-control" name="email" id="emailCad">
                      <small class="text-danger erroEmailCad"></small>
                    </div>

                    <div class="form-group">
                      <label>Sua senha</label>
                      <input type="password" class="form-control" name="password" id="senhaCad">
                      <small class="text-danger erroSenhaCad"></small>
                    </div>

                    <button type="submit" class="btn btn-primary">Criar</button>

                  </form>
            </div>

            <div class="col-lg my-5">
                <h4>Faça o seu login</h4>
                <form class="form-login" action="/login/entrar" method="POST">
                    <input type="hidden" name="_csrf" value=<%= csrfToken%>>
                    <div class="form-group">
                      <label>Seu email</label>
                      <input type="email" class="form-control" name="email" id="emailLog">
                      <small class="text-danger erroEmailLog"></small>
                    </div>

                    <div class="form-group">
                      <label>Sua senha</label>
                      <input type="password" class="form-control" name="password" id="senhaLog">
                      <small class="text-danger erroSenhaLog"></small>
                    </div>

                    <button type="submit" class="btn btn-primary">Entrar</button>

                  </form>
            </div>
        </div>
      </div>

      <div class="col-lg-2"></div>
    </div>
  </div>

<%- include('includes/footer') %>